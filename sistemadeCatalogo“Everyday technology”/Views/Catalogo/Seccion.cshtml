@model sistemadeCatalogo_Everyday_technology_.ViewModels.SeccionProductosViewModel
@using sistemadeCatalogo_Everyday_technology_.Data
@{
    ViewBag.Title = Model.seccion.Nombre;
}

<h2 class="mt-4">@Model.seccion.Nombre</h2>
<p class="text-muted">@Model.seccion.Descripcion</p>
<p>@Html.ActionLink("← Volver al catálogo", "Index", "Catalogo")</p>

@if (Model.Productos.Count == 0)
{
    <div class="alert alert-info">Aún no hay productos en esta sección.</div>
}
else
{
    <div class="row">
        @foreach (var p in Model.Productos)
        {
            var imagen = string.IsNullOrEmpty(p.Imagen) ? "sin-imagen.png" : p.Imagen;
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <img src="@Url.Content("~/Content/Imagenes/" + imagen)" alt="@p.Nombre"
                         class="card-img-top" style="height:200px; object-fit:contain; padding:10px;" />
                    <div class="card-body">
                        <h5 class="card-title">@p.Nombre</h5>
                        <p class="text-muted mb-1">Código: @p.Codigo</p>
                        <p class="card-text">@p.Descripcion</p>
                    </div>
                    <div class="card-footer">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong>$@p.Precio.ToString("N2")</strong>
                            @if (p.Stock == 0)
                            {
                                <span class="badge bg-danger">Agotado</span>
                            }
                            else if (p.Stock <= ProductoRepositorio.StockMinimo)
                            {
                                <span class="badge bg-warning text-dark">¡Stock bajo! Quedan @p.Stock</span>
                            }
                            else
                            {
                                <small class="text-muted">Disponibles: @p.Stock</small>
                            }
                        </div>

                        @if (p.Stock > 0)
                        {
                            using (Html.BeginForm("Agregar", "Carrito", FormMethod.Post, new { @class = "d-flex gap-2" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@p.id" />
                                <input type="hidden" name="returnUrl" value="@Request.RawUrl" />
                                <input type="number" name="cantidad" value="1" min="1" max="@p.Stock"
                                       class="form-control form-control-sm" style="width:80px;" />
                                <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Agregar al carrito</button>
                            }
                        }
                        else
                        {
                            <button type="button" class="btn btn-secondary btn-sm w-100" disabled>Agotado</button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}