@model sistemadeCatalogo_Everyday_technology_.Models.Producto
@{ ViewBag.Title = "Detalles del producto"; }

<h2>Detalles del producto</h2>

<div class="row">
    <div class="col-md-4">
        <img src="~/Content/Imagenes/@Model.Imagen" class="img-fluid rounded" alt="@Model.Nombre" />
    </div>
    <div class="col-md-8">
        <dl class="row">
            <dt class="col-sm-3">Código</dt><dd class="col-sm-9">@Model.Codigo</dd>
            <dt class="col-sm-3">Nombre</dt><dd class="col-sm-9">@Model.Nombre</dd>
            <dt class="col-sm-3">Descripción</dt><dd class="col-sm-9">@Model.Descripcion</dd>
            <dt class="col-sm-3">Precio</dt><dd class="col-sm-9">@Model.Precio.ToString("C")</dd>
        </dl>
        @Html.ActionLink("Editar", "Edit", new { id = Model.id }, new { @class = "btn btn-warning" })
        @Html.ActionLink("Volver", "Index", null, new { @class = "btn btn-secondary" })
    </div>
</div>